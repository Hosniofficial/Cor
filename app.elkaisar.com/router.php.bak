        $cityData = [
            'id_player'  => 0,
            'id_city'    => 0,
            'PlayerName' => 'حاكم مجهول',
            'CityName'   => 'مدينة مهجورة',
            'prestige'   => 0,
            'GuildName'  => 'بدون تحالف',
            'avatar'     => 0
        ];
    }
    sendJson($cityData);
}

