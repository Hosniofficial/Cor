<?php
// Dynamic + Database Router for app.elkaisar.com
require_once __DIR__ . '/db.php';

header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit;
}

$uri = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
$uri = rtrim($uri, '/');

// Log incoming requests for debugging
file_put_contents(__DIR__ . '/api.log', date('Y-m-d H:i:s') . " [" . $_SERVER['REQUEST_METHOD'] . "] " . $uri . " | POST: " . json_encode($_POST) . " | GET: " . json_encode($_GET) . "\n", FILE_APPEND);

// Helper to send text/plain response (so client parses manually without issues)
function sendJson($data) {
    header('Content-Type: text/plain; charset=utf-8');
    echo is_string($data) ? $data : json_encode($data, JSON_UNESCAPED_UNICODE);
    exit;
}

$db = getDB();

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Resource Production & Job Calculation Engine
// ─────────────────────────────────────────────────────────────────────────────
function recalculateCityProduction($db, $cityId) {
    if ($cityId <= 0) return;

    $stmt = $db->prepare("SELECT * FROM city WHERE id_city = ?");
    $stmt->execute([$cityId]);
    $city = $stmt->fetch();
    if (!$city) return;
    $playerId = (int)$city['id_player'];

    // 1. Building Levels
    $bStmt = $db->prepare("SELECT place, type, lvl FROM city_building WHERE id_city = ?");
    $bStmt->execute([$cityId]);
    $buildings = $bStmt->fetchAll() ?: [];

    $jopTable = [
        10, 30, 60, 100, 150, 200,
        300, 500, 750, 1000, 1200, 1250,
        1300, 1350, 1400, 1450, 1500, 1550,
        1600, 1650, 1700, 1750, 1800, 1850,
        1900, 1950, 2000, 2050, 2100, 2150
    ];
    $getCap = function($lvl) use ($jopTable) {
        if ($lvl <= 0) return 0;
        if ($lvl <= 30) return $jopTable[$lvl - 1];
        return 2150 + ($lvl - 30) * 50;
    };

    $maxFarmCap  = 0;
    $maxWoodCap  = 0;
    $maxStoneCap = 0;
    $maxMineCap  = 0;
    $cottageLvls = 0;
    $storeLvls   = 0;
    $palaceLvl   = 1;

    foreach ($buildings as $b) {
        $type = (int)$b['type'];
        $lvl  = (int)$b['lvl'];
        if ($lvl <= 0) continue;

        if ($type === 16) { // Farm
            $maxFarmCap += $getCap($lvl);
        } elseif ($type === 15) { // Wood
            $maxWoodCap += $getCap($lvl);
        } elseif ($type === 18) { // Stone
            $maxStoneCap += $getCap($lvl);
        } elseif ($type === 17) { // Mine
            $maxMineCap += $getCap($lvl);
        } elseif ($type === 1) { // Cottage
            $cottageLvls += $lvl;
        } elseif ($type === 2) { // Store / Warehouse
            $storeLvls += $lvl;
        } elseif ($type === 12) { // Palace
            $palaceLvl = max($palaceLvl, $lvl);
        }
    }

    // Population
    $loy = (int)$city['loy'];
    $popCap = 1000 + ($cottageLvls * 250);
    $popMax = (int)round($popCap * ($loy / 100.0));
    $currentPop = max(500, min($popMax, (int)$city['pop']));

    // 2. City Jobs Record
    $jStmt = $db->prepare("SELECT * FROM city_jop WHERE id_city = ?");
    $jStmt->execute([$cityId]);
    $jop = $jStmt->fetch();

    if (!$jop) {
        $ins = $db->prepare("INSERT INTO city_jop (id_city, id_player, food, wood, stone, metal, food_rate, wood_rate, stone_rate, metal_rate) VALUES (?, ?, ?, ?, ?, ?, 100, 100, 100, 100)");
        $ins->execute([$cityId, $playerId, max(10, $maxFarmCap), max(10, $maxWoodCap), max(10, $maxStoneCap), max(10, $maxMineCap)]);
        $jStmt->execute([$cityId]);
        $jop = $jStmt->fetch();
    } else {
        $newFood  = max((int)$jop['food'],  $maxFarmCap);
        $newWood  = max((int)$jop['wood'],  $maxWoodCap);
        $newStone = max((int)$jop['stone'], $maxStoneCap);
        $newMetal = max((int)$jop['metal'], $maxMineCap);

        if ($newFood !== (int)$jop['food'] || $newWood !== (int)$jop['wood'] || $newStone !== (int)$jop['stone'] || $newMetal !== (int)$jop['metal']) {
            $upJ = $db->prepare("UPDATE city_jop SET food = ?, wood = ?, stone = ?, metal = ? WHERE id_city = ?");
            $upJ->execute([$newFood, $newWood, $newStone, $newMetal, $cityId]);
            $jop['food']  = $newFood;
            $jop['wood']  = $newWood;
            $jop['stone'] = $newStone;
            $jop['metal'] = $newMetal;
        }
    }

    // 3. Effective Production
    $foodRate  = (int)($jop['food_rate'] ?? 100);
    $woodRate  = (int)($jop['wood_rate'] ?? 100);
    $stoneRate = (int)($jop['stone_rate'] ?? 100);
    $metalRate = (int)($jop['metal_rate'] ?? 100);

    $foodEff  = (int)floor(((int)$jop['food'])  * ($foodRate  / 100.0));
    $woodEff  = (int)floor(((int)$jop['wood'])  * ($woodRate  / 100.0));
    $stoneEff = (int)floor(((int)$jop['stone']) * ($stoneRate / 100.0));
    $metalEff = (int)floor(((int)$jop['metal']) * ($metalRate / 100.0));

    // 10 resources per worker per hour
    $foodProd  = max(100, $foodEff  * 10);
    $woodProd  = max(100, $woodEff  * 10);
    $stoneProd = max(100, $stoneEff * 10);
    $metalProd = max(100, $metalEff * 10);

    // Education Bonuses (+10% per level)
    $eStmt = $db->prepare("SELECT * FROM player_edu WHERE id_player = ?");
    $eStmt->execute([$playerId]);
    $edu = $eStmt->fetch() ?: [];

    $farmingLvl = (int)($edu['farming'] ?? 0);
    $woodingLvl = (int)($edu['wooding'] ?? 0);
    $stoningLvl = (int)($edu['stoning'] ?? 0);
    $miningLvl  = (int)($edu['mining']  ?? 0);
    $acctLvl    = (int)($edu['accounting'] ?? 0);

    $foodProd  = (int)round($foodProd  * (1.0 + $farmingLvl * 0.1));
    $woodProd  = (int)round($woodProd  * (1.0 + $woodingLvl * 0.1));
    $stoneProd = (int)round($stoneProd * (1.0 + $stoningLvl * 0.1));
    $metalProd = (int)round($metalProd * (1.0 + $miningLvl  * 0.1));

    // Console hero bonus
    if (!empty($city['console'])) {
        $hStmt = $db->prepare("SELECT point_a, point_a_plus FROM city_hero WHERE id_hero = ?");
        $hStmt->execute([(int)$city['console']]);
        $hero = $hStmt->fetch();
        if ($hero) {
            $cEff = ((int)$hero['point_a'] + (int)$hero['point_a_plus']) / 200.0;
            $foodProd  = (int)round($foodProd  * (1.0 + $cEff));
            $woodProd  = (int)round($woodProd  * (1.0 + $cEff));
            $stoneProd = (int)round($stoneProd * (1.0 + $cEff));
            $metalProd = (int)round($metalProd * (1.0 + $cEff));
        }
    }

    // Taxes / Coins
    $taxs = (int)$city['taxs'];
    $coinProd = max(100, (int)round($currentPop * ($taxs / 100.0) * 10 * (1.0 + $acctLvl * 0.1)));

    // Storage Caps
    $foodCap  = max(100000, 100000 + $storeLvls * 100000);
    $woodCap  = max(100000, 100000 + $storeLvls * 100000);
    $stoneCap = max(100000, 100000 + $storeLvls * 100000);
    $metalCap = max(100000, 100000 + $storeLvls * 100000);
    $coinCap  = max(1000000, 1000000 + $palaceLvl * 1000000);

    // Save back to city table
    $upC = $db->prepare("UPDATE `city` SET 
        `pop_cap` = ?, `pop_max` = ?, `pop` = ?,
        `food_in` = ?, `wood_in` = ?, `stone_in` = ?, `metal_in` = ?, `coin_in` = ?,
        `food_cap` = ?, `wood_cap` = ?, `stone_cap` = ?, `metal_cap` = ?, `coin_cap` = ?
        WHERE `id_city` = ?");
    $upC->execute([
        $popCap, $popMax, $currentPop,
        $foodProd, $woodProd, $stoneProd, $metalProd, $coinProd,
        $foodCap, $woodCap, $stoneCap, $metalCap, $coinCap,
        $cityId
    ]);
}

// ─────────────────────────────────────────────────────────────────────────────
// Timed Tasks Processor (Completes finished buildings, studies, armies, jobs)
// ─────────────────────────────────────────────────────────────────────────────
function processCompletedTasks($db) {
    $now = time();
    $stmt = $db->prepare("SELECT * FROM `timed_task` WHERE `time_arrive` <= ?");
    $stmt->execute([$now]);
    $done = $stmt->fetchAll();

    foreach ($done as $t) {
        $taskId   = (int)$t['id_task'];
        $cityId   = (int)$t['id_city'];
        $playerId = (int)$t['id_player'];
        $type     = $t['task_type'];
        $itemId   = $t['item_id'];
        $lvlTo    = (int)$t['lvl_to'];
        $details  = !empty($t['details']) ? json_decode($t['details'], true) : [];

        if ($type === 'building') {
            $bType = isset($details['type']) ? (int)$details['type'] : 0;
            if ($bType > 0) {
                $up = $db->prepare("INSERT INTO `city_building` (`id_city`, `place`, `type`, `lvl`) VALUES (?, ?, ?, ?) ON DUPLICATE KEY UPDATE `type` = VALUES(`type`), `lvl` = VALUES(`lvl`)");
                $up->execute([$cityId, $itemId, $bType, $lvlTo]);
            } else {
                $up = $db->prepare("UPDATE `city_building` SET `lvl` = ? WHERE `id_city` = ? AND `place` = ?");
                $up->execute([$lvlTo, $cityId, $itemId]);
            }
            recalculateCityProduction($db, $cityId);
        } elseif ($type === 'study') {
            $validStudies = ['farming', 'wooding', 'stoning', 'mining', 'accounting', 'storing', 'building', 'scholership', 'maintenace', 'infantry', 'riding', 'army', 'spying', 'leader', 'safe', 'medicine', 'logistic', 'navigating', 'supplying'];
            if (in_array($itemId, $validStudies)) {
                $up = $db->prepare("UPDATE `player_edu` SET `{$itemId}` = ? WHERE `id_player` = ?");
                $up->execute([$lvlTo, $playerId]);
            }
            recalculateCityProduction($db, $cityId);
        } elseif ($type === 'army') {
            $validArmies = ['army_a', 'army_b', 'army_c', 'army_d', 'army_e', 'army_f'];
            if (in_array($itemId, $validArmies)) {
                $up = $db->prepare("UPDATE `city` SET `{$itemId}` = `{$itemId}` + ? WHERE `id_city` = ?");
                $up->execute([$lvlTo, $cityId]);
            }
            recalculateCityProduction($db, $cityId);
        } elseif ($type === 'jop') {
            $validJops = ['farm' => 'food', 'wood' => 'wood', 'stone' => 'stone', 'mine' => 'metal'];
            $col = $validJops[$itemId] ?? $itemId;
            if (in_array($col, ['food', 'wood', 'stone', 'metal'])) {
                $up = $db->prepare("INSERT INTO `city_jop` (`id_city`, `id_player`, `{$col}`) VALUES (?, ?, ?) ON DUPLICATE KEY UPDATE `{$col}` = `{$col}` + VALUES(`{$col}`)");
                $up->execute([$cityId, $playerId, $lvlTo]);
            }
            recalculateCityProduction($db, $cityId);
        }

        // Delete completed task
        $del = $db->prepare("DELETE FROM `timed_task` WHERE `id_task` = ?");
        $del->execute([$taskId]);
    }
}

// Automatically process any due tasks on each request
processCompletedTasks($db);

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Database Endpoints
// ─────────────────────────────────────────────────────────────────────────────

// 1. Login / Enter Server
if ($uri === '/home/HLogIn/playerEnterServerWeb') {
    // Fetch first player, or create one if none exists
    $stmt = $db->query("SELECT * FROM `player` ORDER BY `id_player` ASC LIMIT 1");
    $player = $stmt->fetch();
    if (!$player) {
        $fresh = createFreshPlayer('البطل سيزر');
        $stmt = $db->prepare("SELECT * FROM `player` WHERE `id_player` = ?");
        $stmt->execute([$fresh['playerId']]);
        $player = $stmt->fetch();
    }

    // Get player's cities
    $cStmt = $db->prepare("SELECT `id_city` FROM `city` WHERE `id_player` = ?");
    $cStmt->execute([$player['id_player']]);
    $cityIds = $cStmt->fetchAll(PDO::FETCH_COLUMN);

    $response = [
        'state'     => 'ok',
        'Player'    => [
            'id_user'    => (int)$player['id_user'],
            'id_player'  => (int)$player['id_player'],
            'user_group' => (int)$player['user_group'],
            'prestige'   => (int)$player['prestige'],
            'honor'      => (int)$player['honor'],
            'gold'       => (int)$player['gold'],
            'avatar'     => (int)$player['avatar'],
            'guild'      => $player['guild'],
            'id_guild'   => $player['id_guild'] ? (int)$player['id_guild'] : null,
            'name'       => $player['name'],
            'lang'       => $player['lang'],
            'city_flag'  => $player['city_flag'],
            'porm'       => (int)$player['porm'],
            'chat_panne' => (int)$player['chat_panne'],
            'online'     => 1,
            'last_seen'  => time(),
            'panned'     => (int)$player['panned'],
            'p_token'    => $player['p_token'],
            'rank'       => (int)$player['rank'],
            'guild_data' => false
        ],
        'Server'    => [
            'id'          => 1,
            'player_num'  => 1,
            'guild_num'   => 0,
            'city_num'    => count($cityIds),
            'hero_num'    => 1,
            'open_status' => 1,
            'under_main'  => 0,
            'port'        => '8082'
        ],
        'JsVersion'  => '-0.0.24',
        'WsPort'     => '8081',
        'WsHost'     => 'localhost',
        'OuthToken'  => $player['p_token'],
        'idServer'   => '1',
        'idCities'   => array_map('intval', $cityIds),
        'PayLink'    => '',
        'RechCode'   => 'local'
    ];
    sendJson($response);
}

// 2. Player State
if ($uri === '/api/APlayer/getPlayerState') {
    $stmt = $db->query("SELECT * FROM `player_state` ORDER BY `id_player` ASC LIMIT 1");
    $state = $stmt->fetch();
    if ($state) {
        foreach ($state as $k => $v) { $state[$k] = (int)$v; }
        sendJson($state);
    }
}

// 3. Refresh Player Data
if ($uri === '/api/APlayer/refreshPlayerData') {
    $stmt = $db->query("SELECT * FROM `player` ORDER BY `id_player` ASC LIMIT 1");
    $p = $stmt->fetch();
    if ($p) {
        $p['id_player'] = (int)$p['id_player'];
        $p['prestige']  = (int)$p['prestige'];
        $p['gold']      = (int)$p['gold'];
        $p['honor']     = (int)$p['honor'];
        sendJson($p);
    }
}

// 4. City Base / Resources (Calculates Real-Time Production!)
if ($uri === '/api/ACity/refreshCityBase' || $uri === '/api/ACity/getCityBase') {
    $cityId = isset($_GET['idCity']) ? (int)$_GET['idCity'] : (isset($_POST['idCity']) ? (int)$_POST['idCity'] : 0);
    if ($cityId > 0) {
        $stmt = $db->prepare("SELECT * FROM `city` WHERE `id_city` = ?");
        $stmt->execute([$cityId]);
    } else {
        $stmt = $db->query("SELECT * FROM `city` ORDER BY `id_city` ASC LIMIT 1");
    }
    $city = $stmt->fetch();

    if ($city) {
        $cityId = (int)$city['id_city'];
        // Recalculate production rates so they are always 100% accurate with all buildings
        recalculateCityProduction($db, $cityId);
        $stmt = $db->prepare("SELECT * FROM `city` WHERE `id_city` = ?");
        $stmt->execute([$cityId]);
        $city = $stmt->fetch();

        $now = time();
        $elapsed = max(0, $now - (int)$city['LS']);
        if ($elapsed > 0) {
            $foodGain  = (int)round(($city['food_in']  - $city['food_out'])  * ($elapsed / 3600));
            $woodGain  = (int)round(($city['wood_in']  - $city['wood_out'])  * ($elapsed / 3600));
            $stoneGain = (int)round(($city['stone_in'] - $city['stone_out']) * ($elapsed / 3600));
            $metalGain = (int)round(($city['metal_in'] - $city['metal_out']) * ($elapsed / 3600));
            $coinGain  = (int)round(($city['coin_in']  - $city['coin_out'])  * ($elapsed / 3600));

            $city['food']  = min((int)$city['food_cap'],  max(0, (int)$city['food']  + $foodGain));
            $city['wood']  = min((int)$city['wood_cap'],  max(0, (int)$city['wood']  + $woodGain));
            $city['stone'] = min((int)$city['stone_cap'], max(0, (int)$city['stone'] + $stoneGain));
            $city['metal'] = min((int)$city['metal_cap'], max(0, (int)$city['metal'] + $metalGain));
            $city['coin']  = min((int)$city['coin_cap'],  max(0, (int)$city['coin']  + $coinGain));
            $city['LS']    = $now;

            $uStmt = $db->prepare("UPDATE `city` SET `food` = ?, `wood` = ?, `stone` = ?, `metal` = ?, `coin` = ?, `LS` = ? WHERE `id_city` = ?");
            $uStmt->execute([$city['food'], $city['wood'], $city['stone'], $city['metal'], $city['coin'], $now, $city['id_city']]);
        }

        foreach ($city as $k => $v) {
            if (is_numeric($v)) $city[$k] = (int)$v;
        }
        sendJson($city);
    }
}

// 5. City Buildings (Get Levels & Types)
if ($uri === '/api/ACityBuilding/getCityBuilding') {
    $cityId = isset($_GET['idCity']) ? (int)$_GET['idCity'] : 1;
    $stmt = $db->prepare("SELECT `place`, `type`, `lvl` FROM `city_building` WHERE `id_city` = ?");
    $stmt->execute([$cityId]);
    $rows = $stmt->fetchAll();

    $lvl  = [];
    $type = [];
    foreach ($rows as $row) {
        $lvl[$row['place']]  = (int)$row['lvl'];
        $type[$row['place']] = (int)$row['type'];
    }
    sendJson(['lvl' => $lvl, 'type' => $type]);
}

// 5b. Construct New Building Action (With Real Countdown Timer!)
if ($uri === '/api/ACityBuilding/constructNewBuilding') {
    $cityId = isset($_REQUEST['idCity']) ? (int)$_REQUEST['idCity'] : 1;
    $place  = isset($_REQUEST['buildingPlace']) ? trim($_REQUEST['buildingPlace']) : '';
    $type   = isset($_REQUEST['buildingType']) ? (int)$_REQUEST['buildingType'] : 0;

    if ($cityId <= 0) {
        $cStmt = $db->query("SELECT id_city FROM city ORDER BY id_city ASC LIMIT 1");
        $cityId = (int)$cStmt->fetchColumn();
    }

    if (!empty($place) && $type > 0) {
        $stmt = $db->prepare("SELECT id_player FROM city WHERE id_city = ?");
        $stmt->execute([$cityId]);
        $playerId = (int)$stmt->fetchColumn() ?: 1;

        $duration = 30; // 30 seconds for construction
        $now = time();
        $arrive = $now + $duration;

        $stmt = $db->prepare("INSERT INTO `timed_task` (`id_city`, `id_player`, `task_type`, `item_id`, `lvl_to`, `start_time`, `time_arrive`, `details`) VALUES (?, ?, 'building', ?, 1, ?, ?, ?)");
        $stmt->execute([$cityId, $playerId, $place, $now, $arrive, json_encode(['type' => $type])]);
        $taskId = (int)$db->lastInsertId();

        // Mark in city_building with type
        $stmt = $db->prepare("INSERT INTO `city_building` (`id_city`, `place`, `type`, `lvl`) VALUES (?, ?, ?, 0) ON DUPLICATE KEY UPDATE `type` = VALUES(`type`)");
        $stmt->execute([$cityId, $place, $type]);

        // Deduct starter cost
        $stmt = $db->prepare("UPDATE `city` SET `food` = GREATEST(0, `food` - 100), `wood` = GREATEST(0, `wood` - 100), `stone` = GREATEST(0, `stone` - 100) WHERE `id_city` = ?");
        $stmt->execute([$cityId]);

        sendJson([
            'state' => 'ok',
            'list'  => [
                [
                    'id'           => $taskId,
                    'id_city'      => $cityId,
                    'type'         => $type,
                    'place'        => $place,
                    'lvl_to'       => 1,
                    'time_start'   => $now,
                    'time_end'     => $arrive,
                    'time_end_org' => $arrive
                ]
            ]
        ]);
    }
    sendJson(['state' => 'error', 'msg' => 'Invalid parameters']);
}

// 5c. Upgrade Building Action (With Real Countdown Timer!)
if ($uri === '/api/ACityBuilding/upgrade') {
    $cityId = isset($_REQUEST['idCity']) ? (int)$_REQUEST['idCity'] : 1;
    $place  = isset($_REQUEST['buildingPlace']) ? trim($_REQUEST['buildingPlace']) : '';

    if ($cityId <= 0) {
        $cStmt = $db->query("SELECT id_city FROM city ORDER BY id_city ASC LIMIT 1");
        $cityId = (int)$cStmt->fetchColumn();
    }

    if (!empty($place)) {
        $stmt = $db->prepare("SELECT b.type, b.lvl, c.id_player FROM city_building b JOIN city c ON b.id_city = c.id_city WHERE b.id_city = ? AND b.place = ?");
        $stmt->execute([$cityId, $place]);
        $curr = $stmt->fetch();
        $type = (int)($curr['type'] ?? 0);
        $currLvl = (int)($curr['lvl'] ?? 0);
        $playerId = (int)($curr['id_player'] ?? 1);
        $nextLvl = $currLvl + 1;

        $duration = max(30, min(600, $nextLvl * 45)); // 45s per level
        $now = time();
        $arrive = $now + $duration;

        $stmt = $db->prepare("INSERT INTO `timed_task` (`id_city`, `id_player`, `task_type`, `item_id`, `lvl_to`, `start_time`, `time_arrive`, `details`) VALUES (?, ?, 'building', ?, ?, ?, ?, ?)");
        $stmt->execute([$cityId, $playerId, $place, $nextLvl, $now, $arrive, json_encode(['type' => $type])]);
        $taskId = (int)$db->lastInsertId();

        // Deduct upgrade cost
        $stmt = $db->prepare("UPDATE `city` SET `wood` = GREATEST(0, `wood` - 200), `stone` = GREATEST(0, `stone` - 200), `metal` = GREATEST(0, `metal` - 100) WHERE `id_city` = ?");
        $stmt->execute([$cityId]);

        sendJson([
            'state' => 'ok',
            'list'  => [
                [
                    'id'           => $taskId,
                    'id_city'      => $cityId,
                    'type'         => $type,
                    'place'        => $place,
                    'lvl_to'       => $nextLvl,
                    'time_start'   => $now,
                    'time_end'     => $arrive,
                    'time_end_org' => $arrive
                ]
            ]
        ]);
    }
    sendJson(['state' => 'error', 'msg' => 'Invalid parameters']);
}

// 5d. Downgrade Building
if ($uri === '/api/ACityBuilding/downgrade') {
    $cityId = isset($_REQUEST['idCity']) ? (int)$_REQUEST['idCity'] : 1;
    $place  = isset($_REQUEST['buildingPlace']) ? trim($_REQUEST['buildingPlace']) : '';
    if (!empty($place)) {
        $stmt = $db->prepare("UPDATE `city_building` SET `lvl` = GREATEST(0, `lvl` - 1) WHERE `id_city` = ? AND `place` = ?");
        $stmt->execute([$cityId, $place]);
        sendJson(['state' => 'ok', 'list' => []]);
    }
    sendJson(['state' => 'error', 'msg' => 'Invalid parameters']);
}

// 5e. Demolish Building completely
if ($uri === '/api/ACityBuilding/explodeBuilding') {
    $cityId = isset($_REQUEST['idCity']) ? (int)$_REQUEST['idCity'] : 1;
    $place  = isset($_REQUEST['buildingPlace']) ? trim($_REQUEST['buildingPlace']) : '';
    if (!empty($place)) {
        $stmt = $db->prepare("UPDATE `city_building` SET `type` = 0, `lvl` = 0 WHERE `id_city` = ? AND `place` = ?");
        $stmt->execute([$cityId, $place]);
        sendJson(['state' => 'ok', 'list' => []]);
    }
    sendJson(['state' => 'error', 'msg' => 'Invalid parameters']);
}

// 6. Player Education (Get Levels)
if ($uri === '/api/APlayerEdu/getPlayerEduLvl') {
    $stmt = $db->query("SELECT * FROM `player_edu` ORDER BY `id_player` ASC LIMIT 1");
    $edu = $stmt->fetch();
    if ($edu) {
        foreach ($edu as $k => $v) { $edu[$k] = (int)$v; }
        sendJson($edu);
    }
}

// 6b. Upgrade Study Level Action (With Real Countdown Timer!)
if ($uri === '/api/APlayerEdu/upgradeStudyLvl') {
    $cityId  = isset($_REQUEST['idCity']) ? (int)$_REQUEST['idCity'] : 1;
    $idStudy = isset($_REQUEST['idStudy']) ? trim($_REQUEST['idStudy']) : '';

    $stmt = $db->prepare("SELECT c.id_player FROM city c WHERE c.id_city = ?");
    $stmt->execute([$cityId]);
    $playerId = (int)$stmt->fetchColumn() ?: 1;

    $stmt = $db->prepare("SELECT * FROM player_edu WHERE id_player = ?");
    $stmt->execute([$playerId]);
    $edu = $stmt->fetch();
    $currLvl = isset($edu[$idStudy]) ? (int)$edu[$idStudy] : 0;
    $nextLvl = $currLvl + 1;

    $duration = max(30, min(600, $nextLvl * 60));
    $now = time();
    $arrive = $now + $duration;

    $stmt = $db->prepare("UPDATE `city` SET `coin` = GREATEST(0, `coin` - 500), `food` = GREATEST(0, `food` - 300) WHERE `id_city` = ?");
    $stmt->execute([$cityId]);

    $stmt = $db->prepare("INSERT INTO `timed_task` (`id_city`, `id_player`, `task_type`, `item_id`, `lvl_to`, `start_time`, `time_arrive`, `details`) VALUES (?, ?, 'study', ?, ?, ?, ?, ?)");
    $stmt->execute([$cityId, $playerId, $idStudy, $nextLvl, $now, $arrive, json_encode(['study_in' => 'academy'])]);
    $taskId = (int)$db->lastInsertId();

    $cStmt = $db->prepare("SELECT * FROM city WHERE id_city = ?");
    $cStmt->execute([$cityId]);
    $cityRes = $cStmt->fetch();
    foreach ($cityRes as $k => $v) { if (is_numeric($v)) $cityRes[$k] = (int)$v; }

    sendJson([
        'state'   => 'ok',
        'cityRes' => $cityRes,
        'list'    => [
            [
                'id'           => $taskId,
                'id_city'      => $cityId,
                'study'        => $idStudy,
                'study_in'     => 'academy',
                'lvl_to'       => $nextLvl,
                'time_start'   => $now,
                'time_end'     => $arrive,
                'time_end_org' => $arrive
            ]
        ]
    ]);
}

// 7. City Heroes
if ($uri === '/api/ACityHero/getCityHero') {
    $stmt = $db->query("SELECT * FROM `city_hero` ORDER BY `id_hero` ASC");
    $heroes = $stmt->fetchAll();
    foreach ($heroes as &$h) {
        foreach ($h as $k => $v) {
            if (is_numeric($v)) $h[$k] = (int)$v;
        }
    }
    sendJson($heroes);
}

// 7b. City Hero Army
if ($uri === '/api/ACityHero/getCityHeroArmy') {
    $stmt = $db->query("SELECT * FROM `hero_army` ORDER BY id_hero ASC");
    $rows = $stmt->fetchAll() ?: [];
    foreach ($rows as &$r) {
        foreach (['id_hero', 'id_player', 'f_1_type', 'f_1_num', 'f_2_type', 'f_2_num', 'f_3_type', 'f_3_num', 'b_1_type', 'b_1_num', 'b_2_type', 'b_2_num', 'b_3_type', 'b_3_num'] as $col) {
            $r[$col] = (int)$r[$col];
        }
    }
    sendJson($rows);
}

// 7b-2. Refresh Single Hero Army
if ($uri === '/api/AHeroArmy/refreshHeroArmy') {
    $idHero = (int)($_GET['idHero'] ?? $_POST['idHero'] ?? 0);
    $stmt = $db->prepare("SELECT * FROM `hero_army` WHERE id_hero = ?");
    $stmt->execute([$idHero]);
    $army = $stmt->fetch();
    if (!$army) {
        $army = [
            'id_hero'   => $idHero,
            'id_player' => 1,
            'f_1_type'  => 0, 'f_1_num' => 0,
            'f_2_type'  => 0, 'f_2_num' => 0,
            'f_3_type'  => 0, 'f_3_num' => 0,
            'b_1_type'  => 0, 'b_1_num' => 0,
            'b_2_type'  => 0, 'b_2_num' => 0,
            'b_3_type'  => 0, 'b_3_num' => 0,
            'is_trans'  => null
        ];
        $db->prepare("INSERT IGNORE INTO `hero_army` (id_hero, id_player) VALUES (?, 1)")->execute([$idHero]);
    } else {
        foreach (['id_hero', 'id_player', 'f_1_type', 'f_1_num', 'f_2_type', 'f_2_num', 'f_3_type', 'f_3_num', 'b_1_type', 'b_1_num', 'b_2_type', 'b_2_num', 'b_3_type', 'b_3_num'] as $col) {
            $army[$col] = (int)$army[$col];
        }
    }
    sendJson(['state' => 'ok', 'HeroArmy' => $army]);
}

// 7b-3. Add Mayor / Console Hero
if ($uri === '/api/AHero/addConsole') {
    $idHero = (int)($_POST['idHero'] ?? $_GET['idHero'] ?? 0);
    $hStmt = $db->prepare("SELECT * FROM `city_hero` WHERE id_hero = ?");
    $hStmt->execute([$idHero]);
    $hero = $hStmt->fetch();
    if (!$hero) {
        sendJson(['state' => 'error_1']);
    }
    $idCity = (int)$hero['id_city'];
    $db->prepare("UPDATE `city_hero` SET console = 0 WHERE id_city = ?")->execute([$idCity]);
    $db->prepare("UPDATE `city_hero` SET console = 1 WHERE id_hero = ?")->execute([$idHero]);
    $db->prepare("UPDATE `city` SET console = ? WHERE id_city = ?")->execute([$idHero, $idCity]);
    recalculateCityProduction($db, $idCity);

    $cStmt = $db->prepare("SELECT * FROM `city` WHERE id_city = ?");
    $cStmt->execute([$idCity]);
    $city = $cStmt->fetch();
    foreach ($city as $k => $v) { if (is_numeric($v)) $city[$k] = (int)$v; }

    $hlStmt = $db->prepare("SELECT * FROM `city_hero` WHERE id_city = ?");
    $hlStmt->execute([$idCity]);
    $heroList = $hlStmt->fetchAll() ?: [];
    foreach ($heroList as &$h) {
        foreach ($h as $k => $v) { if (is_numeric($v)) $h[$k] = (int)$v; }
    }

    sendJson([
        'state' => 'ok',
        'City' => $city,
        'HeroList' => $heroList
    ]);
}

// 7b-4. Remove Mayor / Console Hero
if ($uri === '/api/AHero/removeConsole') {
    $idCity = (int)($_POST['idCity'] ?? $_GET['idCity'] ?? 0);
    $db->prepare("UPDATE `city_hero` SET console = 0 WHERE id_city = ?")->execute([$idCity]);
    $db->prepare("UPDATE `city` SET console = NULL WHERE id_city = ?")->execute([$idCity]);
    recalculateCityProduction($db, $idCity);

    $cStmt = $db->prepare("SELECT * FROM `city` WHERE id_city = ?");
    $cStmt->execute([$idCity]);
    $city = $cStmt->fetch();
    foreach ($city as $k => $v) { if (is_numeric($v)) $city[$k] = (int)$v; }

    $hlStmt = $db->prepare("SELECT * FROM `city_hero` WHERE id_city = ?");
    $hlStmt->execute([$idCity]);
    $heroList = $hlStmt->fetchAll() ?: [];
    foreach ($heroList as &$h) {
        foreach ($h as $k => $v) { if (is_numeric($v)) $h[$k] = (int)$v; }
    }

    sendJson([
        'state' => 'ok',
        'City' => $city,
        'HeroList' => $heroList
    ]);
}

